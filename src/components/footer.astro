---
import { Facebook, Instagram, MailOpen } from "@lucide/astro";
import Button from "@components/button.astro";
---

<footer class="bg-moh-dark-blue my-4 py-8">
    <div
        class="flex w-[90%] max-w-(--panel-width) mx-auto flex-col items-center justify-between gap-8 md:grid md:gap-2 md:grid-cols-[1fr_1fr_1fr]"
    >
        <div class="sitemap">
            <ul>
                <li>
                    <a href="/">Home</a>
                </li>
                <li>
                    <a href="/write-a-message">Write a Message</a>
                </li>
                <li>
                    <a href="/get-involved">Get Involved</a>
                </li>
                <li>
                    <a href="/colouring-pages">Colouring Pages</a>
                </li>
            </ul>
            <ul>
                <li>
                    <a href="/our-work">Our Work</a>
                </li>
                <li>
                    <a href="/our-story">Our Story</a>
                </li>
                <li>
                    <a href="/our-team">Our Team</a>
                </li>
            </ul>
            <ul>
                <li>
                    <a href="/campaigns">Campaigns</a>
                </li>
                <li>
                    <a href="/bags-of-hope">Bags of Hope</a>
                </li>
                <li>
                    <a href="/line-of-hope">Line of Hope</a>
                </li>
                <li>
                    <a href="/messages-of-hope">Messages of Hope</a>
                </li>
            </ul>
            <ul>
                <li>
                    <a href="/events">Events</a>
                </li>
                <li>
                    <a href="/events/react-bag-packing-2024"
                        >React Bag Packing</a
                    >
                </li>
                <li>
                    <a href="/events/feeling-blue-2024">Feeling Blue</a>
                </li>
                <li>
                    <a href="/events/connections-2024">Connections 2024</a>
                </li>
            </ul>
        </div>

        <div class="buttons">
            <div class="flex gap-2 text-zinc-100">
                <a
                    href="https://www.instagram.com/messagesof.hope/"
                    aria-label="Instagram"
                    target="_blank"
                >
                    <Instagram />
                </a>
                <a
                    href="https://www.facebook.com/people/Messages-of-Hope/100087952429971/"
                    aria-label="Facebook"
                    target="_blank"
                >
                    <Facebook />
                </a>
                <a
                    href="mailto:contact@messagesofhope.co.uk"
                    aria-label="Email Us"
                >
                    <MailOpen />
                </a>
            </div>

            <Button href="/write-a-message" colour="yellow">
                Write a Message
            </Button>
            <Button href="/events/react-bag-packing-2024">
                Our Latest Event
            </Button>
        </div>

        <div class="details">
            <p>Messages of Hope (MOH) C.I.C</p>
            <p>Company Number 15299854</p>
            <p>contact@messagesofhope.co.uk</p>
        </div>

        <div class="copyright">
            <p>
                All rights reserved © 2023-26 Messages of Hope. We are a
                registered community interest company in England and Wales.
            </p>
            <a href="/privacy-policy" target="_blank"> privacy policy </a>
        </div>
    </div>
</footer>

<style>
    .sitemap {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 1rem;
        width: 100%;
        flex-wrap: wrap;
    }

    .sitemap ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 0.25rem;
        margin: 0;
    }

    .sitemap a {
        color: var(--color-zinc-100);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        font-family: var(--font-heading);
    }

    .sitemap ul > li:first-child a {
        font-weight: 700;
    }

    .buttons {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        align-self: flex-end;
    }

    .details {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        justify-content: center;
        width: 100%;
    }

    .details p {
        width: 100%;
        text-align: end;
        color: var(--color-zinc-100);
        font-size: 0.8rem;
    }

    .copyright {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 0.25rem;
        width: 100%;
    }

    .copyright p {
        color: var(--color-zinc-100);
        font-size: 0.8rem;
        font-weight: 500;
        font-family: var(--font-heading);
        width: 100%;
    }

    .copyright a {
        color: var(--color-zinc-100);
        text-decoration: underline;
        font-size: 0.8rem;
        font-weight: 500;
        font-family: var(--font-heading);
    }

    @media (min-width: 48rem) {
        .sitemap {
            grid-column: 1 / 4;
            grid-row: 1 / 3;
            align-self: flex-start;
        }

        .buttons {
            grid-column: 4 / 5;
            grid-row: 1 / 2;
            align-items: flex-end;
        }

        .details {
            grid-column: 4 / 5;
            grid-row: 2 / 3;
        }

        .copyright {
            margin-top: 0.5rem;
            grid-column: 1 / 5;
            grid-row: 3 / 4;
        }
    }
</style>
