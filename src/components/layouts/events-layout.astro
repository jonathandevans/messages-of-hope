---
import BaseLayout from "./base-layout.astro";

const {
    title,
    absolute,
    noIndex,
    description,
    text,
    class: backgroundClass,
    heading,
    ...rest
} = Astro.props;
---

<BaseLayout title={title} absolute={absolute} noIndex={noIndex} description={description}>
    <main class="flex flex-col gap-y-16 mb-12 relative">
        <section class={`banner ${backgroundClass}`} {...rest}>
            <div class="inner">
                <h1 class="tracking-tight">{heading ? heading : title}</h1>
                <p>{text}</p>
            </div>

            <span class="art1"></span>
            <span class="art2"></span>
            <span class="art3"></span>
            <span class="art4"></span>
            <span class="art5"></span>

            <span class="art6"></span>
            <span class="art7"></span>
            <span class="art8"></span>
            <span class="art9"></span>
            <span class="art10"></span>
        </section>

        <slot />
    </main>
</BaseLayout>

<style>
    .banner {
        position: relative;
    }

    .banner .art1 {
        position: absolute;
        bottom: -1rem;
        left: -1.5rem;
        width: 4rem;
        height: 4rem;
        z-index: 1;
        background: var(--color-moh-yellow);
        border-radius: 50%;
    }

    .banner .art2 {
        position: absolute;
        bottom: -2.5rem;
        left: 2rem;
        width: 5rem;
        height: 5rem;
        z-index: 3;
        background: var(--color-moh-blue);
        border-radius: 50%;
    }

    .banner .art3 {
        position: absolute;
        bottom: -0.5rem;
        left: 6rem;
        width: 3rem;
        height: 3rem;
        z-index: 2;
        background: var(--color-moh-dark-blue);
        border-radius: 50%;
    }

    .banner .art4 {
        position: absolute;
        bottom: -1.75rem;
        left: 8rem;
        width: 4rem;
        height: 4rem;
        z-index: 1;
        background: var(--color-moh-yellow);
        border-radius: 50%;
    }

    .banner .art5 {
        position: absolute;
        bottom: -1rem;
        left: 11rem;
        width: 3rem;
        height: 3rem;
        z-index: 2;
        background: var(--color-moh-blue);
        border-radius: 50%;
    }

    .banner .art6 {
        position: absolute;
        bottom: -3rem;
        right: -1.5rem;
        width: 5rem;
        height: 5rem;
        z-index: 1;
        background: var(--color-moh-yellow);
        border-radius: 50%;
    }

    .banner .art7 {
        position: absolute;
        bottom: -2.5rem;
        right: 2rem;
        width: 5rem;
        height: 5rem;
        z-index: 3;
        background: var(--color-moh-dark-blue);
        border-radius: 50%;
    }

    .banner .art8 {
        position: absolute;
        bottom: -0.5rem;
        right: 6rem;
        width: 3rem;
        height: 3rem;
        z-index: 2;
        background: var(--color-moh-blue);
        border-radius: 50%;
    }

    .banner .art9 {
        position: absolute;
        bottom: -3rem;
        right: 8rem;
        width: 5rem;
        height: 5rem;
        z-index: 1;
        background: var(--color-moh-dark-blue);
        border-radius: 50%;
    }

    .banner .art10 {
        position: absolute;
        bottom: -2rem;
        right: 12rem;
        width: 3rem;
        height: 3rem;
        z-index: 2;
        background: var(--color-moh-yellow);
        border-radius: 50%;
    }

    .banner .inner {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: flex-start;
        width: 90%;
        max-width: 76rem;
        margin: 0 auto;
        padding-bottom: 3rem;
        height: 23rem;
        gap: 0.25rem;
    }

    .banner h1 {
        margin: 0;
        font-size: 3rem;
        color: var(--color-zinc-100);
    }

    .banner p {
        font-size: 1.25rem;
        font-style: italic;
        color: var(--color-zinc-100);
        width: 100%;
    }
</style>
