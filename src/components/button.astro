---
import { ArrowRightIcon } from "@lucide/astro";

const {
    href,
    colour = "blue",
    size = "base",
    target = "_self",
    class: _class = "",
} = Astro.props as {
    href: string;
    colour?: "blue" | "yellow" | "outline";
    size?: "sm" | "base";
    target?: "_self" | "_blank" | "_parent" | "_top";
    class?: string;
};

const baseClass =
    "flex gap-2 items-center font-heading font-semibold tracking-tight w-fit transition-all rounded-md";
const colourOptions = {
    blue: "bg-moh-blue hover:bg-moh-blue/75",
    yellow: "bg-moh-yellow hover:bg-moh-yellow/75",
    outline:
        "border-2 border-moh-dark-blue text-moh-dark-blue hover:opacity-75",
};
const sizeOptions = {
    base: "py-2 px-4",
    sm: "text-sm py-1.5 px-3",
};

const classCompound =
    baseClass +
    " " +
    colourOptions[colour] +
    " " +
    sizeOptions[size] +
    " " +
    _class;
---

<a href={href} class={classCompound} target={target}
    ><slot /> <ArrowRightIcon class="size-4" /></a
>
